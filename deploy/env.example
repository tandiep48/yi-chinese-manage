# Copy to /opt/yi-chinese/.env on the ECS VM and fill in real values.
# This file is committed as a template; the real .env is never committed.

# Public origin of the app — used by Flask for session cookies / CORS.
# Use http://<ECS_PUBLIC_IP> until you have a domain + TLS, then https://<domain>.
PUBLIC_ORIGIN=http://REPLACE_WITH_IP_OR_DOMAIN

# ── Frontend build-time vars (baked into the web image; rebuild to change) ────
NEXT_PUBLIC_GCS_BUCKET_URL=https://storage.googleapis.com/chinese-learning-audio-assets

# ── Postgres (the db container) ───────────────────────────────────────────────
POSTGRES_DB=chinese
POSTGRES_USER=chinese
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ── Flask ─────────────────────────────────────────────────────────────────────
# Stable 64-char hex; a random one per restart invalidates every session.
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=REPLACE_WITH_64_CHAR_HEX

# ── Google Cloud Storage (audio/avatar assets) ───────────────────────────────
GCS_BUCKET_URL=https://storage.googleapis.com/chinese-learning-audio-assets
GCS_BUCKET_NAME=chinese-learning-audio-assets
# Optional — only avatar uploads need it. Paste the whole service-account JSON on
# one line. Reads (public URLs) work without it.
# GCS_SA_KEY_JSON=

# Leave DB_SSLMODE unset: the db container serves plaintext on the private docker
# network. Only set it for an external TLS Postgres.
# DB_SSLMODE=
